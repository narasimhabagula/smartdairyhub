{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "smart-dairy-hub-mcp",
      "version": "0.1.0",
      "title": "Smart Dairy Hub"
    },
    "tools": [
      {
        "name": "search_milk_rates",
        "title": "Search milk rates",
        "description": "List today's milk procurement rates from dairy companies on Smart Dairy Hub. Optionally filter by milk_type (cow/buffalo/mixed) and limit results.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "milk_type": {
              "type": "string",
              "enum": [
                "cow",
                "buffalo",
                "mixed"
              ],
              "description": "Filter by milk type"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Max rows (default 20)"
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "calculate_milk_price",
        "title": "Calculate milk price",
        "description": "Calculate milk price from FAT %, SNF %, and litres using the Smart Dairy Hub rate formula (rate = FAT*fat_rate + SNF*snf_rate).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "fat": {
              "type": "number",
              "minimum": 0,
              "maximum": 15,
              "description": "Fat percentage"
            },
            "snf": {
              "type": "number",
              "minimum": 0,
              "maximum": 15,
              "description": "Solids-not-fat percentage"
            },
            "litres": {
              "type": "number",
              "minimum": 0,
              "description": "Volume in litres"
            },
            "fat_rate": {
              "type": "number",
              "minimum": 0,
              "description": "Rate per unit FAT (default 6.5)"
            },
            "snf_rate": {
              "type": "number",
              "minimum": 0,
              "description": "Rate per unit SNF (default 4.0)"
            }
          },
          "required": [
            "fat",
            "snf",
            "litres"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "find_vets",
        "title": "Find veterinary doctors",
        "description": "Find veterinary doctors listed on Smart Dairy Hub, optionally filtered by district or specialization. Contact details are private — users must contact vets via the app.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "district": {
              "type": "string",
              "description": "District name filter (case-insensitive contains)"
            },
            "specialization": {
              "type": "string",
              "description": "Specialization filter"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_schemes",
        "title": "List government schemes",
        "description": "List active government dairy schemes, subsidies, and loans (NABARD, PM Kisan, etc.) published on Smart Dairy Hub.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "description": "Optional category filter"
            },
            "search": {
              "type": "string",
              "description": "Text search in title/description"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "search_cattle_listings",
        "title": "Search cattle marketplace",
        "description": "Search active cattle listings (cows, buffaloes) on the Smart Dairy Hub marketplace. Seller contact info is private — buyers must contact via the app.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "description": "Animal type e.g. cow, buffalo"
            },
            "breed": {
              "type": "string",
              "description": "Breed filter (contains)"
            },
            "district": {
              "type": "string",
              "description": "District filter (contains)"
            },
            "max_price": {
              "type": "number",
              "description": "Maximum price"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "search_faqs",
        "title": "Search FAQs",
        "description": "Search Smart Dairy Hub FAQ knowledge base for answers about dairy farming, milk production, animal health, and platform usage.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Search text"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
